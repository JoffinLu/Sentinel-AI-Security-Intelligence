# ===== LLM 配置 =====
# 主路径：DeepSeek 兼容接口
LLM_API_BASE=https://api.openveer.com/v1
LLM_API_KEY=
# 留空则问答 / 富化走降级模式；可在系统「LLM 模型设置」中添加自己的 Key
LLM_MODEL=DeepSeek-v4-flash-Free
# 推理模型（用于富化分析、问答推理链）
LLM_REASONING_MODEL=DeepSeek-R1-Free
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
# 灰区复核专用模型（避免用推理模型，其思考过程会耗尽 token 预算）
LLM_ECONOMY_MODEL=DeepSeek-v4-flash-Free
# 降级路径：本地 Ollama（未部署时自动跳过）
LLM_FALLBACK_BASE=http://localhost:11434/v1
LLM_FALLBACK_MODEL=qwen2.5:7b

# ===== 数据库配置 =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_security_intel
POSTGRES_USER=aiintel
POSTGRES_PASSWORD=aiintel2026
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
# 嵌入向量维度（BGE-M3 为 1024，本地降级模型 bge-small-zh 为 512）
EMBEDDING_DIM=1024

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== 知识图谱配置 =====
NEO4J_HOST=localhost
NEO4J_PORT=17474
NEO4J_BOLT_PORT=17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aiintel2026

# ===== 采集器配置 =====
# NVD 官方建议申请 API Key，可将速率限制从 5 次/30秒提升至 50 次/30秒
NVD_API_KEY=
# 请求超时与重试
COLLECTOR_TIMEOUT_SECONDS=90
COLLECTOR_MAX_RETRIES=3
COLLECTOR_RATE_LIMIT_RPS=2.0
# 各数据源调度间隔（秒），对应性能指标"监测时效性"
SCHEDULE_NVD_INTERVAL=21600
SCHEDULE_ADVISORY_INTERVAL=21600
SCHEDULE_OSV_INTERVAL=43200
SCHEDULE_CISA_INTERVAL=43200
SCHEDULE_ARXIV_INTERVAL=43200
SCHEDULE_EXPLOITDB_INTERVAL=43200
SCHEDULE_RSS_INTERVAL=3600
SCHEDULE_ATLAS_INTERVAL=604800
# AI 相关性过滤阈值
AI_RELEVANCE_RULE_THRESHOLD=1.0
AI_RELEVANCE_EMBEDDING_THRESHOLD=0.62
AI_RELEVANCE_LLM_THRESHOLD=0.5
# 采集入库后是否启用 LLM 复核
ENABLE_LLM_REVIEW=true

# ===== 服务配置 =====
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# 允许在无 LLM 情况下启动（降级运行）
ALLOW_DEGRADED_START=true
