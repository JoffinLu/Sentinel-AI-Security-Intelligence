# 前端可视化界面镜像
# 构建阶段产出静态文件，运行阶段用 Nginx 托管

# 基础镜像走国内源——直连 Docker Hub 在受限网络下会超时。
# 需要官方源时改为：--build-arg BASE_REGISTRY=docker.io/library
ARG BASE_REGISTRY=docker.1ms.run/library
ARG NODE_IMAGE=${BASE_REGISTRY}/node:22-alpine
ARG NGINX_IMAGE=${BASE_REGISTRY}/nginx:alpine

# ---------- 构建 ----------
FROM ${NODE_IMAGE} AS builder

WORKDIR /build

# npm 同样走国内镜像，避免 registry.npmjs.org 超时
RUN npm config set registry https://registry.npmmirror.com

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY . .
RUN npm run build


# ---------- 运行 ----------
FROM ${NGINX_IMAGE}

# 安全加固：非 root 运行。nginx 官方镜像需改用 root 启动 master 进程，
# 再以 nginx 用户运行 worker。
RUN touch /var/run/nginx.pid \
    && chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /etc/nginx/conf.d \
    && sed -i 's|^pid .*|pid /var/run/nginx.pid;|' /etc/nginx/nginx.conf

COPY --from=builder /build/dist /usr/share/nginx/html
# nginx 配置：若构建上下文为项目根则用此路径；
# 若上下文为「前端界面」目录（见 compose 配置），改用 COPY nginx.conf ...
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=4s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
